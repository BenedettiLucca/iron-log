{
  "name": "iron-log",
  "main": "expo-router/entry",
  "version": "3.16.0",
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=22.22.2 <23.0.0",
    "npm": ">=10.9.7 <11.0.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --testPathIgnorePatterns '__tests__/services/session-lifecycle.test.ts' && jest __tests__/services/session-lifecycle.test.ts --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "audit:high": "node scripts/audit-high.js",
    "export:android": "expo export --platform android --max-workers 1 --output-dir dist",
    "verify:android-export": "node scripts/verify-android-export.js",
    "verify": "npm run typecheck && npm run lint && npm run test:coverage && npm run export:android && npm run verify:android-export"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
