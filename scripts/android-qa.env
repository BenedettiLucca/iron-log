# Android QA shared env — sourced by scripts/qa.sh
# Safe to edit; nothing here is secret.

# Resolve real user home via passwd — background lanes may run with a polluted $HOME
QA_USER_HOME="$(getent passwd "$(id -u)" | cut -d: -f6)"

# Some lane sandboxes export a repo-local ANDROID_HOME without an emulator binary;
# QA needs the emulator-capable SDK in the user home.
export ANDROID_HOME="${ANDROID_HOME:-$QA_USER_HOME/android-sdk}"
[ -x "$ANDROID_HOME/emulator/emulator" ] || export ANDROID_HOME="$QA_USER_HOME/android-sdk"
export JAVA_HOME="${JAVA_HOME:-/usr/lib/jvm/java-17-openjdk}"
export PATH="$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator:$ANDROID_HOME/cmdline-tools/latest/bin:$QA_USER_HOME/.maestro/bin:$PATH"

AVD_NAME="ironlog-qa"
APP_ID="com.lucca.ironlog"
BOOT_TIMEOUT="${BOOT_TIMEOUT:-180}"  # override no TCG/software-emulation boots
MAESTRO_FLOWS_DIR=".maestro"
EVIDENCE_DIR=".qa-artifacts"

# Emulator port is fixed so device serial is deterministic (emulator-5554).
# Override with a USB serial (adb devices) to QA on a physical device instead.
EMU_PORT="${EMU_PORT:-5554}"
DEVICE_SERIAL="${DEVICE_SERIAL:-emulator-$EMU_PORT}"
